# ====================
# CORE APPLICATION
# ====================

# Application base URL (used for OAuth callbacks)
APP_BASE_URL=http://localhost:3000

# NextAuth secret (for signing tokens, sessions, etc.)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-secret-here

# ====================
# DATABASE (Supabase)
# ====================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# ====================
# GOOGLE APIS
# ====================

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_MAPS_API_KEY=your-maps-api-key

# ====================
# AI SERVICES
# ====================

GEMINI_API_KEY=your-gemini-api-key

# ====================
# SECURITY (NEW)
# ====================

# Customer API Key - unique per deployment (prevents unauthorized API access)
# Generate with: node -e "console.log(require('crypto').randomUUID())"
CUSTOMER_API_KEY=your-unique-api-key-here

# Cron Secret - protects cron endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Superadmin Key - protects /superadmin dashboard
SUPERADMIN_KEY=your-superadmin-key-here

# ====================
# ERROR MONITORING (Sentry)
# ====================

# Sentry DSN (server-side) - Get from sentry.io dashboard
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry DSN (client-side) - Usually same as SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry Organization slug (for source map uploads)
SENTRY_ORG=your-org-slug

# Sentry Project slug (for source map uploads)
SENTRY_PROJECT=your-project-slug

# Sentry Auth Token (for source map uploads during build)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-auth-token-here

# ====================
# OPTIONAL
# ====================

# Node environment
NODE_ENV=development
